.list{max-width:1050px;margin:0 auto;padding:20px 5vw 20px;display:grid;grid-template-columns:repeat(2,1fr);gap:12px;font-size:13px}
.list b{color:#fff}
.form-wrap{max-width:600px;margin:20px auto 40px;background:#111;border:1px solid rgba(212,175,55,0.3);border-radius:18px;padding:28px}
