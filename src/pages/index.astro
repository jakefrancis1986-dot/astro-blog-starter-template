<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MYSTIC NORTH SOUND | Music Production Studio & Live Events</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Inter:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root{--black:#0a0a0a;--gold:#d4af6a;--gold-light:#e8c88a;--white:#ffffff;}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--black);color:var(--white);font-family:'Inter',sans-serif;overflow-x:hidden}
.gold-border{position:fixed;top:12px;left:12px;right:12px;bottom:12px;border:1px solid var(--gold);pointer-events:none;z-index:100;opacity:0.6}
.gold-border::before{content:'';position:absolute;top:6px;left:6px;right:6px;bottom:6px;border:1px solid var(--gold);opacity:0.8}
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:60px 20px;position:relative}
.logo-svg{width:180px;height:180px;filter:drop-shadow(0 0 20px rgba(212,175,106,0.2))}
.waveform{width:420px;max-width:90vw;height:40px;margin:16px 0;opacity:0.9}
.mtn-row{width:520px;max-width:92vw;margin:8px auto 32px}
h1{font-weight:800;letter-spacing:0.04em;font-size:clamp(32px,6vw,68px);line-height:0.95;margin-bottom:12px}
.sub{color:var(--gold);font-weight:500;letter-spacing:0.22em;font-size:clamp(10px,1.3vw,13px);text-transform:uppercase;margin-bottom:28px}
.icons{display:flex;gap:28px;justify-content:center;margin-bottom:28px;color:var(--gold)}
.icons svg{width:28px;height:28px}
.divider{width:420px;max-width:80vw;height:1px;background:var(--gold);opacity:0.6;margin:0 auto 32px}
.contact{display:flex;flex-direction:column;gap:8px;font-size:clamp(16px,2vw,20px);font-weight:500}
.contact a{color:var(--white);text-decoration:none}
.contact a:hover{color:var(--gold)}
.contact .small{font-size:13px;opacity:0.7;font-weight:400;margin-top:6px}
.cta{margin-top:36px;display:flex;gap:16px;flex-wrap:wrap;justify-content:center}
.btn{padding:14px 28px;border:1px solid var(--gold);color:var(--gold);background:transparent;text-transform:uppercase;letter-spacing:0.18em;font-size:12px;font-weight:600;cursor:pointer;transition:0.3s;text-decoration:none}
.btn:hover{background:var(--gold);color:var(--black)}
.btn-solid{background:var(--gold);color:var(--black)}
section{padding:80px 20px;max-width:1100px;margin:0 auto;text-align:center}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px;margin-top:40px}
.card{border:1px solid rgba(212,175,106,0.25);padding:32px 24px;background:rgba(255,255,255,0.02);transition:0.3s}
.card:hover{border-color:var(--gold);background:rgba(212,175,106,0.05)}
.card h3{color:var(--gold);font-family:'Cinzel';letter-spacing:0.12em;margin-bottom:10px}
footer{padding:40px 20px 80px;text-align:center;border-top:1px solid rgba(212,175,106,0.15);margin-top:60px;color:rgba(255,255,255,0.5);font-size:12px}
</style>
</head>
<body>
<div class="gold-border"></div>
<div class="hero">
  <svg class="logo-svg" viewBox="0 0 200 200" fill="none">
    <circle cx="100" cy="100" r="78" stroke="#d4af6a" stroke-width="1.5"/>
    <circle cx="100" cy="100" r="72" stroke="#d4af6a" stroke-width="0.5" opacity="0.6"/>
    <g stroke="#d4af6a" stroke-width="1">
      <path d="M100 12 L102 22 L100 28 L98 22 Z"/>
      <path d="M100 172 L102 182 L100 188 L98 182 Z"/>
    </g>
    <text x="100" y="10" text-anchor="middle" fill="#d4af6a" font-size="14" font-family="Cinzel">N</text>
    <text x="100" y="198" text-anchor="middle" fill="#d4af6a" font-size="14" font-family="Cinzel">S</text>
    <text x="10" y="105" text-anchor="middle" fill="#d4af6a" font-size="14" font-family="Cinzel">W</text>
    <text x="190" y="105" text-anchor="middle" fill="#d4af6a" font-size="14" font-family="Cinzel">E</text>
    <text x="100" y="122" text-anchor="middle" fill="#d4af6a" font-size="66" font-family="serif">𝄞</text>
  </svg>

  <svg class="waveform" viewBox="0 0 500 40" fill="#d4af6a">
    <path d="M0 20 Q5 5 10 20 T20 20 T30 20 T40 20 T50 8 T60 20 T70 25 T80 20 T90 10 T100 20 T110 5 T120 20 T130 30 T140 20 T150 18 T160 20 T170 22 T180 20 T190 8 T200 20 T210 20 T220 20 T230 15 T240 20 T250 20 T260 20 T270 20 T280 12 T290 20 T300 28 T310 20 T320 20 T330 10 T340 20 T350 6 T360 20 T370 24 T380 20 T390 16 T400 20 T410 20 T420 8 T430 20 T440 20 T450 20 T460 20 T470 20 T480 20 T500 20" stroke="#d4af6a" stroke-width="1" fill="none"/>
  </svg>

  <svg class="mtn-row" viewBox="0 0 600 70" fill="#d4af6a">
    <path d="M0 65 L80 20 L140 55 L200 15 L280 60 L350 25 L420 60 L500 18 L600 65 Z" opacity="0.9"/>
  </svg>

  <h1>MYSTIC NORTH SOUND</h1>
  <div class="sub">Music Production Studio & Live Events / Sound Tech</div>

  <div class="divider"></div>

  <div class="contact">
    <a href="tel:7055610253">705-561-0253</a>
    <a href="https://mysticnorth.ca">mysticnorth.ca</a>
    <a href="mailto:contact@mysticnorth.ca">contact@mysticnorth.ca</a>
    <div class="small">Markstay, ON • Sudbury to North Bay & Beyond</div>
  </div>

  <div class="cta">
    <a href="mailto:contact@mysticnorth.ca" class="btn btn-solid">Book Sound</a>
    <a href="tel:7055610253" class="btn">Call Now</a>
  </div>
</div>

<section>
  <div class="sub">Services</div>
  <div class="grid">
    <div class="card"><h3>Studio Production</h3><p>Tracking, mixing, mastering. Northern grit, world-class sound.</p></div>
    <div class="card"><h3>Live Sound</h3><p>PA, monitors, FOH engineer for venues, festivals, weddings.</p></div>
    <div class="card"><h3>Sound Tech</h3><p>Pro audio rentals & tech — Sudbury to North Bay & beyond.</p></div>
  </div>
</section>

<footer>MYSTIC NORTH SOUND — Markstay, Ontario © 2026</footer>
</body>
</html>
