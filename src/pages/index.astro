html,body{margin:0;padding:0;background:#040a14 !important;color:#e8f1f5;font-family:system-ui,Segoe UI,sans-serif;overflow-x:hidden}
.sky{position:fixed;inset:0;z-index:0;background:linear-gradient(180deg,#0a1426 0%,#091423 35%,#060d18 100%);overflow:hidden}
.stars{position:absolute;inset:0;background-image:radial-gradient(1.5px 1.5px at 12% 18%,#fff 100%,transparent 0),radial-gradient(1px 1px at 23% 8%,rgba(255,255,255,.9) 100%,transparent 0),radial-gradient(1.2px 1.2px at 35% 15%,#fff 100%,transparent 0),radial-gradient(1px 1px at 48% 22%,#fff 100%,transparent 0),radial-gradient(1.5px 1.5px at 65% 12%,#fff 100%,transparent 0),radial-gradient(1px 1px at 78% 28%,rgba(255,255,255,.8) 100%,transparent 0),radial-gradient(1.3px 1.3px at 88% 10%,#fff 100%,transparent 0);opacity:.85;animation:twinkle 8s ease-in-out infinite alternate}
@keyframes twinkle{0%{opacity:.6}100%{opacity:1}}
.aurora{position:absolute;inset:-30% -10% 0 -10%;filter:blur(18px) brightness(1.2);opacity:.9}
.aurora span{position:absolute;width:120%;height:55%;border-radius:50%;mix-blend-mode:screen;opacity:.7}
.aurora .a1{top:-10%;left:-15%;background:radial-gradient(60% 80% at 30% 40%,rgba(90,255,180,0.9),rgba(60,255,180,0.3) 40%,transparent 75%);transform:rotate(-8deg);animation:drift1 22s ease-in-out infinite alternate}
.aurora .a2{top:-18%;left:15%;background:radial-gradient(55% 70% at 60% 50%,rgba(120,110,255,0.75),rgba(120,90,255,0.25) 45%,transparent 80%);transform:rotate(5deg);animation:drift2 28s ease-in-out infinite alternate}
