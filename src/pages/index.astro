footer .bottom-loc{color:#7ff0c5;font-weight:800;margin-bottom:10px;letter-spacing:3px;font-size:14px}
@media(max-width:850px){.grid{grid-template-columns:1fr}.list{grid-template-columns:1fr}.topbar{flex-direction:column;gap:6px}}
