.form-wrap button{width:100%;padding:14px;background:linear-gradient(135deg, #D4AF37, #FFD700);color:#000;border:none;border-radius:10px;font-weight:900;letter-spacing:1px;cursor:pointer}
footer{text-align:center;padding:32px 20px;font-size:12px;letter-spacing:2px;border-top:1px solid rgba(212,175,55,0.2);margin-top:40px;background:#0a0a0a}
footer .bottom-loc{color:#D4AF37;font-weight:800;margin-bottom:10px;letter-spacing:3px;font-size:14px}
@media(max-width:850px){.grid{grid-template-columns:1fr}.list{grid-template-columns:1fr}.topbar{flex-direction:column;gap:6px}}
