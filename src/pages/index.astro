@keyframes drift1{0%{transform:translateX(-2%) rotate(-8deg)}100%{transform:translateX(4%) rotate(-4deg)}}
@keyframes drift2{0%{transform:translateX(3%) rotate(5deg)}100%{transform:translateX(-3%) rotate(2deg)}}
.moon{position:absolute;top:8%;right:10%;width:68px;height:68px;background:radial-gradient(circle at 35% 35%,#fff 0%,#e6f3ff 35%,#b8d0ea 70%,transparent 75%);border-radius:50%;box-shadow:0 0 40px rgba(180,210,255,.6),0 0 80px rgba(140,180,255,.3);opacity:.9}
