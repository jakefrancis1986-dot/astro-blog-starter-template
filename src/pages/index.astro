.btn2{border:1px solid #D4AF37;color:#D4AF37}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1100px;margin:50px auto;padding:0 5vw}
.card{border:1px solid rgba(212,175,55,0.3);background:#111;border-radius:16px;padding:24px;text-align:left}
